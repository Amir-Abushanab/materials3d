{
  "name": "materials-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Design Materials3D scenes in the browser and export them as code, config, stills, or clips",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "prebuild": "node ../../scripts/ensure-standalone.mjs",
    "predev": "node ../../scripts/ensure-standalone.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@materials3d/core": "workspace:*",
    "gifenc": "^1.0.3",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.3",
    "three": "^0.186.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
