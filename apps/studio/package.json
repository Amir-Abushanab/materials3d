{
  "name": "materials-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Design refractive-glass scenes in the browser and export them as code, config, or stills",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "prebuild": "node ../../scripts/ensure-standalone.mjs",
    "predev": "node ../../scripts/ensure-standalone.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@materials3d/core": "workspace:*",
    "gifenc": "^1.0.3",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/three": "^0.185.0",
    "jsdom": "^30.0.1",
    "three": "^0.185.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.11"
  }
}
