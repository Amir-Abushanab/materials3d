{
  "name": "materials3d-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Materials Studio and the @materials3d packages that power it",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"@materials3d/*\" build",
    "calibrate": "node scripts/calibrate.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm knip && pnpm gallery:validate",
    "depcruise": "dependency-cruiser apps packages",
    "dev": "pnpm --filter materials-studio dev",
    "format": "oxfmt . '!gallery/**'",
    "format:check": "oxfmt . --check '!gallery/**'",
    "gallery:build": "pnpm --filter @materials3d/core build:standalone && node scripts/build-gallery.mjs",
    "gallery:validate": "pnpm --filter @materials3d/core build:standalone && node scripts/validate-gallery.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "ncu": "pnpm dlx npm-check-updates",
    "pack:all": "pnpm -r --filter \"@materials3d/*\" exec pnpm pack",
    "prepare": "git config core.hooksPath .githooks",
    "prerender": "pnpm --filter @materials3d/core build:standalone",
    "preview": "pnpm --filter materials-studio preview",
    "release": "pnpm build:packages && node scripts/publish-if-needed.mjs",
    "render": "node scripts/render.mjs",
    "test": "pnpm -r test",
    "tsl:feasibility": "node scripts/tsl-feasibility.mjs",
    "tsl:compare": "pnpm --filter @materials3d/core build && node scripts/tsl-compare.mjs",
    "tsl:parity": "pnpm --filter @materials3d/core build && node scripts/tsl-parity.mjs",
    "tsl:smoke": "pnpm --filter @materials3d/core build && node scripts/tsl-engine-smoke.mjs",
    "tsl:chrome": "node scripts/real-chrome-smoke.mjs",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "dependency-cruiser": "^18.1.0",
    "knip": "^6.29.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.16.0"
}
