{
  "name": "materials3d-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Materials Studio and the @materials3d packages that power it",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"@materials3d/*\" build",
    "calibrate": "node scripts/calibrate.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm knip && pnpm licenses:check && pnpm skill:validate && pnpm gallery:validate",
    "depcruise": "dependency-cruiser apps packages scripts",
    "dev": "pnpm --filter materials-studio dev",
    "format": "oxfmt . '!gallery/**'",
    "format:check": "oxfmt . --check '!gallery/**'",
    "gallery:build": "node scripts/ensure-standalone.mjs && node scripts/build-gallery.mjs",
    "gallery:validate": "node scripts/ensure-standalone.mjs && node scripts/validate-gallery.mjs",
    "knip": "knip",
    "licenses:check": "node scripts/check-licenses.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "pack:all": "pnpm -r --filter \"@materials3d/*\" exec pnpm pack",
    "prepare": "git config core.hooksPath .githooks || true",
    "preset:from": "node scripts/preset-from-config.mjs",
    "preview": "pnpm --filter materials-studio preview",
    "release": "pnpm build:packages && node scripts/publish-if-needed.mjs",
    "prerender": "node scripts/ensure-standalone.mjs",
    "render": "node scripts/render.mjs",
    "skill:stale": "pnpm --filter @materials3d/core skill:stale",
    "skill:validate": "pnpm --filter @materials3d/core skill:validate",
    "presweep": "node scripts/ensure-standalone.mjs",
    "sweep": "node scripts/sweep.mjs",
    "test": "pnpm -r test",
    "tsl:chrome": "node scripts/real-chrome-smoke.mjs",
    "tsl:compare": "pnpm --filter @materials3d/core build && node scripts/tsl-compare.mjs",
    "tsl:interaction": "pnpm --filter @materials3d/core build && node scripts/tsl-interaction.mjs",
    "tsl:live": "pnpm --filter @materials3d/core build && node scripts/research/tsl-live.mjs",
    "tsl:parity": "pnpm --filter @materials3d/core build && node scripts/tsl-parity.mjs",
    "tsl:perf": "pnpm --filter @materials3d/core build && node scripts/tsl-perf.mjs",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version && node scripts/sync-skill-version.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "dependency-cruiser": "^18.1.0",
    "knip": "^6.29.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.13",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.16.0"
}
