{
  "name": "@materials3d/react",
  "version": "0.1.0",
  "description": "Drop-in refractive-glass scene for React: the <Materials3D> component",
  "keywords": [
    "background",
    "component",
    "glass",
    "react",
    "refraction",
    "three",
    "threejs",
    "webgl"
  ],
  "homepage": "https://github.com/Amir-Abushanab/materials3d/tree/main/packages/react#readme",
  "bugs": "https://github.com/Amir-Abushanab/materials3d/issues",
  "license": "MIT",
  "author": "Amir Abushanab (https://github.com/Amir-Abushanab)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Abushanab/materials3d.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@materials3d/core": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "@types/three": ">=0.180",
    "react": ">=18",
    "three": ">=0.180 <1"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
